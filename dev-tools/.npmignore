# npm-only ignore list for dev-tools/.
#
# WHY THIS FILE EXISTS: npm falls back to .gitignore when no .npmignore is present, and
# dev-tools/.gitignore ignores `dist/` (build output, not committed). But the ROOT package.json's
# `files` list ships `dev-tools/dist/testing` on purpose — it is `@eco-incorp/sauce/testing` — and an
# ignore exclusion beats a `files` inclusion, so without this file the tarball would ship without
# it. `check-packed-package.mjs` imports the subpath from the installed tarball, so a regression
# fails there.
#
# Keep the rest of dev-tools/.gitignore's exclusions mirrored below, MINUS `dist/`. Anything added
# there that should not ship must be added here too.
node_modules/
out/
cache/
artifacts/

# Local deployment state
.deployment.json

# Logs
*.log
npm-debug.log*

# IDE
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# TypeScript
*.tsbuildinfo
