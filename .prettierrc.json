{
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "sdk/src/std/**/*.js",
      "options": {
        "parser": "typescript"
      }
    },
    {
      "files": "skills/**/*.sauce.ts",
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
