{
  "name": "sauce-agent-demo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sauce": "sauce",
    "skills:install": "sauce skills install",
    "skills:update": "sauce skills update",
    "skills:status": "sauce skills status",
    "check": "sauce skills status && tsc -p tsconfig.json",
    "e2e": "node e2e/distributed-swap.e2e.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@eco-incorp/sauce": "link:../sauce-sdk",
    "viem": "2.57.1"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@uniswap/v3-core": "1.0.1",
    "@uniswap/v4-core": "1.0.2",
    "prettier": "3.9.9",
    "solc": "0.8.26",
    "typescript": "5.9.3"
  }
}
