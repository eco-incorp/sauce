# Dependencies
node_modules/

# Build outputs
dist/
out/
cache/
artifacts/
*.tsbuildinfo
# Copies of the std, recipe, ABI-twin and skill files the SDK embeds, written by
# `sdk/scripts/gen-embedded-sources.mjs` from those files on every build, typecheck and test.
sdk/src/embedded/*.generated.ts

# Local state
.deployment.json
.integration-test-state.json

# Env
.env
.env.local

# RPC URLs for sdk/scripts/capture-registry-abi.mjs --rpc-config (see sdk/rpc.config.example.json)
sdk/rpc.config.json

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Coverage
coverage/
lcov.info

# Left by the removed sdk/scripts/build-wasm.mjs. The script is gone but a contributor who ran the
# old pretest still has the output; keep this until those working copies have turned over.
sdk/.sauce-wasm/

# Agents' git worktrees. The skill links beside them in .claude/skills are tracked.
/.claude/worktrees/

# The third-party Solana programs the suites run. Only those whose licence allows it are committed
# (each `!` line); `sdk/scripts/fetch-program-fixtures.mjs` reads the rest from mainnet-beta, held to
# the pins in each fixture's manifest.json (sdk/test/fixtures/fetched-programs.json lists them). A
# new dump is ignored until it is un-ignored here or listed there.
sdk/test/fixtures/svm-venue-programs/*.so.gz
!sdk/test/fixtures/svm-venue-programs/byreal.so.gz
!sdk/test/fixtures/svm-venue-programs/phoenix.so.gz
!sdk/test/fixtures/svm-venue-programs/raydium-clmm.so.gz
!sdk/test/fixtures/svm-venue-programs/stabble-clmm.so.gz
sdk/test/fixtures/svm-exact-in-programs/*.so.gz
!sdk/test/fixtures/svm-exact-in-programs/helium-circuit-breaker.so.gz
!sdk/test/fixtures/svm-exact-in-programs/helium-treasury.so.gz
!sdk/test/fixtures/svm-exact-in-programs/infinity-flat-slab.so.gz
!sdk/test/fixtures/svm-exact-in-programs/infinity-multi-pool.so.gz
!sdk/test/fixtures/svm-exact-in-programs/infinity-sanctum-pool.so.gz
!sdk/test/fixtures/svm-exact-in-programs/infinity-spl-pool.so.gz
!sdk/test/fixtures/svm-exact-in-programs/orca-legacy-token-swap.so.gz
!sdk/test/fixtures/svm-exact-in-programs/orca-v1.so.gz
!sdk/test/fixtures/svm-exact-in-programs/raydium-amm-v4.so.gz
!sdk/test/fixtures/svm-exact-in-programs/raydium-cp-swap.so.gz
!sdk/test/fixtures/svm-exact-in-programs/saber-stableswap.so.gz
!sdk/test/fixtures/svm-exact-in-programs/saros.so.gz
!sdk/test/fixtures/svm-exact-in-programs/token-swap-v1.so.gz

# Canonical Permit2's runtime, which compiles in AGPL code. Only its pin is committed
# (Permit2.pin.json: chain, address, keccak256); `sdk/scripts/fetch-contract-code.mjs` reads the code
# from Ethereum, holds it to the pin and writes this file, the pin plus `runtime`.
sdk/test/fixtures/cli/Permit2.json
