# Dependencies
node_modules/

# Build outputs
dist/
out/
cache/
artifacts/
*.tsbuildinfo
# Copies of the std, recipe, ABI-twin and skill files the SDK embeds, written by
# `sdk/scripts/gen-embedded-sources.mjs` from those files on every build, typecheck and test.
sdk/src/embedded/*.generated.ts

# Local state
.deployment.json
.integration-test-state.json

# Env
.env
.env.local

# RPC URLs for sdk/scripts/capture-registry-abi.mjs --rpc-config (see sdk/rpc.config.example.json)
sdk/rpc.config.json

# Logs
*.log
npm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Coverage
coverage/
lcov.info

# Left by the removed sdk/scripts/build-wasm.mjs. The script is gone but a contributor who ran the
# old pretest still has the output; keep this until those working copies have turned over.
sdk/.sauce-wasm/

# Agents' git worktrees. The skill links beside them in .claude/skills are tracked.
/.claude/worktrees/
