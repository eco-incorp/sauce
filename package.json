{
  "name": "@eco-incorp/sauce",
  "version": "1.0.0",
  "description": "Sauce protocol tooling: the SDK, action primitives, the sauce command and the Sauce MCP server.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eco-incorp/sauce.git"
  },
  "homepage": "https://sauce.eco.com",
  "license": "SEE LICENSE IN LICENSE.md",
  "bugs": "https://github.com/eco-incorp/sauce/issues",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "sdk/dist/index.js",
  "types": "sdk/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./sdk/dist/index.d.ts",
      "default": "./sdk/dist/index.js"
    },
    "./compiler": {
      "types": "./sdk/dist/compiler.d.ts",
      "default": "./sdk/dist/compiler.js"
    },
    "./actions": {
      "types": "./actions/dist/index.d.ts",
      "default": "./actions/dist/index.js"
    },
    "./actions/action-program.schema.json": "./actions/action-program.schema.json",
    "./testing": {
      "types": "./dev-tools/dist/testing/index.d.ts",
      "default": "./dev-tools/dist/testing/index.js"
    },
    "./protocols/*": {
      "types": "./sdk/dist/protocols/*/index.d.ts",
      "default": "./sdk/dist/protocols/*/index.js"
    },
    "./chains": {
      "types": "./sdk/dist/chains/index.d.ts",
      "default": "./sdk/dist/chains/index.js"
    },
    "./recipes": {
      "types": "./sdk/dist/recipes/index.d.ts",
      "default": "./sdk/dist/recipes/index.js"
    },
    "./recipes/settle.sauce.ts": "./sdk/dist/recipes/settle.sauce.ts",
    "./deployments": {
      "types": "./sdk/dist/deployments/index.d.ts",
      "default": "./sdk/dist/deployments/index.js"
    },
    "./skills": {
      "types": "./sdk/dist/skills/loader.d.ts",
      "default": "./sdk/dist/skills/loader.js"
    },
    "./svm": {
      "types": "./sdk/dist/svm/index.d.ts",
      "default": "./sdk/dist/svm/index.js"
    },
    "./svm/engine": {
      "types": "./sdk/dist/svm/engine-public.d.ts",
      "default": "./sdk/dist/svm/engine-public.js"
    },
    "./svm/engine-artifacts": {
      "types": "./sdk/dist/svm/engine-artifacts.d.ts",
      "default": "./sdk/dist/svm/engine-artifacts.js"
    },
    "./evm/engine": {
      "types": "./sdk/dist/evm/engine.d.ts",
      "default": "./sdk/dist/evm/engine.js"
    },
    "./svm/verify": {
      "types": "./sdk/dist/svm/verify.d.ts",
      "default": "./sdk/dist/svm/verify.js"
    },
    "./svm/recipes/settle.sauce.ts": "./sdk/dist/svm/recipes/settle.sauce.ts",
    "./verify": {
      "types": "./sdk/dist/verify/index.d.ts",
      "default": "./sdk/dist/verify/index.js"
    },
    "./sauce-script": {
      "types": "./sdk/dist/sauce-script/index.d.ts"
    }
  },
  "bin": {
    "sauce": "./sdk/dist/cli/main.js"
  },
  "files": [
    "LICENSE.md",
    "sdk/dist",
    "sdk/runtime",
    "actions/dist",
    "mcp/dist",
    "dev-tools/dist/testing",
    "actions/action-program.schema.json",
    "sdk/src/protocols",
    "skills",
    "docs/**/*.md",
    "docs/examples/*.ts"
  ],
  "scripts": {
    "docs:check": "node docs/scripts/check-docs.mjs",
    "skills:check": "node sdk/scripts/check-skills.mjs",
    "check:browser": "node sdk/scripts/check-browser-bundles.mjs && node sdk/scripts/check-browser-compile.mjs",
    "build": "pnpm -r --filter './sdk' --filter './actions' --filter './mcp' --filter './dev-tools' build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@noble/ciphers": "1.3.0",
    "@noble/hashes": "1.8.0",
    "@solana-program/address-lookup-table": "^0.15.0",
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.5.0",
    "@sveltejs/acorn-typescript": "1.0.13",
    "acorn": "8.16.0",
    "sauce-compiler": "npm:@eco-incorp/sauce-compiler@2.5.0",
    "viem": "^2.45.3"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "*",
    "litesvm": "*",
    "zod": "*"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    },
    "litesvm": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "@uniswap/v3-core": "^1.0.1",
    "@uniswap/v4-core": "^1.0.2",
    "esbuild": "0.28.0",
    "eslint": "10.10.0",
    "globals": "16.5.0",
    "litesvm": "1.6.0",
    "playwright-core": "1.63.0",
    "prettier": "3.9.6",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.70.0",
    "zod": "4.6.5"
  },
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24"
  }
}
